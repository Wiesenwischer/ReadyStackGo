---
interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

const content = {
  de: {
    badge: 'v1.0 Release in Vorbereitung',
    title: 'Version 1.0 kommt bald',
    description: 'ReadyStackGo befindet sich in der Endphase vor dem ersten offiziellen Release. Die Kernfunktionalität ist stabil und wird aktiv genutzt — v1.0 steht kurz bevor.',
    points: [
      'Kernfunktionalität vollständig implementiert',
      'Aktiv in Entwicklung und getestet',
      'v1.0 Release steht kurz bevor',
      'Feedback und Beiträge sind willkommen',
    ],
  },
  en: {
    badge: 'v1.0 Release Coming Soon',
    title: 'Version 1.0 is Almost Here',
    description: 'ReadyStackGo is in the final phase before its first official release. The core functionality is stable and actively used — v1.0 is just around the corner.',
    points: [
      'Core functionality fully implemented',
      'Actively developed and tested',
      'v1.0 release coming soon',
      'Feedback and contributions welcome',
    ],
  },
};

const c = content[lang];
---

<section class="py-16 bg-primary-subtle border-y border-primary-subtle-line">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <!-- Badge -->
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-primary-subtle-line text-fg-brand text-sm font-medium mb-6">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {c.badge}
      </span>

      <!-- Title -->
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-fg mb-4">
        {c.title}
      </h2>

      <!-- Description -->
      <p class="text-lg text-fg-secondary max-w-3xl mx-auto mb-8">
        {c.description}
      </p>

      <!-- Points -->
      <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {c.points.map((point) => (
          <div class="flex items-center gap-3 text-left bg-surface/70 border border-primary-subtle-line rounded-lg px-4 py-3">
            <svg class="w-5 h-5 text-fg-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-fg">{point}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
