---
import { t, type Lang, getDocsPath } from '../i18n/translations';
import { getInstallCommand } from '../config';

interface Props {
	lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const installCmd = getInstallCommand(Astro.url.origin);
---

<section class="relative overflow-hidden bg-page py-16 lg:py-[90px]">
	<div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-10">
		<div class="grid lg:grid-cols-[minmax(0,640px)_minmax(0,1fr)] gap-12 lg:gap-16 items-center">
			<!-- Text column -->
			<div>
				<!-- Badge -->
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-primary-subtle border border-primary-subtle-line rounded-full mb-7">
					<span class="w-2 h-2 bg-go rounded-full"></span>
					<span class="text-[13px] font-medium text-fg-brand">{t(lang, 'hero.badge')}</span>
				</div>

				<!-- Headline -->
				<h1 class="font-display font-extrabold text-[40px] leading-[46px] sm:text-[48px] sm:leading-[56px] xl:text-[53px] xl:leading-[62px] tracking-[-0.8px] text-fg mb-8">
					{t(lang, 'hero.title1')}
					<br />
					<span class="text-fg-brand">{t(lang, 'hero.title2').trim()}</span>
				</h1>

				<!-- Subheadline -->
				<p class="text-lg sm:text-[19px] leading-[30px] text-fg-secondary mb-7 max-w-[620px]">
					{t(lang, 'hero.subtitle')}
				</p>

				<!-- CTA Buttons -->
				<div class="flex flex-col sm:flex-row gap-3">
					<a
						href="#installation"
						class="inline-flex items-center justify-center h-12 px-[18px] bg-primary hover:bg-primary-hover text-on-primary font-semibold text-[15px] rounded-[10px] transition-colors"
					>
						{t(lang, 'hero.cta.install')}
					</a>
					<a
						href={getDocsPath(lang)}
						class="inline-flex items-center justify-center h-12 px-[18px] bg-surface dark:bg-transparent text-fg font-semibold text-[15px] rounded-[10px] border border-line-strong hover:border-fg-brand hover:text-fg-brand transition-colors"
					>
						{t(lang, 'hero.cta.docs')}
					</a>
				</div>

				<!-- Quick install command -->
				<div class="mt-6 bg-surface border border-line rounded-xl px-4 py-3.5 text-left overflow-x-auto">
					<div class="text-[13px] text-fg-secondary mb-1">{t(lang, 'hero.quickinstall')}</div>
					<code class="font-mono text-[13px] text-fg-brand break-all">{installCmd}</code>
				</div>
			</div>

			<!-- Image column -->
			<div class="relative">
				<img
					src="/images/hero/readystackgo-hero.webp"
					alt=""
					width="1232"
					height="840"
					class="w-full h-auto aspect-[616/420] object-cover rounded-[24px] shadow-theme-lg"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>
</section>
