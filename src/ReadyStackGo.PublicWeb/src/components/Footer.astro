---
import { t, type Lang, getDocsPath } from '../i18n/translations';
import Logo from './Logo.astro';

interface Props {
	lang?: Lang;
}

const { lang = 'de' } = Astro.props;
---

<footer class="bg-page py-12 border-t border-line">
	<div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-10">
		<div class="flex flex-col md:flex-row items-center justify-between gap-6">
			<!-- Logo -->
			<a href={`/${lang}/home/`} class="flex items-center" aria-label="ReadyStackGo">
				<Logo />
			</a>

			<!-- Links -->
			<nav class="flex items-center gap-6">
				<a href={getDocsPath(lang)} class="text-fg-secondary hover:text-fg-brand transition-colors text-theme-sm font-medium">{t(lang, 'footer.docs')}</a>
				<span class="text-line-strong">|</span>
				<a href={lang === 'de' ? '/de/datenschutz/' : '/en/privacy/'} class="text-fg-secondary hover:text-fg-brand transition-colors text-theme-sm font-medium">{t(lang, 'footer.privacy')}</a>
				<span class="text-line-strong">|</span>
				<a href={lang === 'de' ? '/de/impressum/' : '/en/imprint/'} class="text-fg-secondary hover:text-fg-brand transition-colors text-theme-sm font-medium">{t(lang, 'footer.imprint')}</a>
			</nav>
		</div>
	</div>
</footer>
